# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright test artifacts
test-results/
playwright-report/

# Nightly-sync salvage drop (sync-bills.yml writes the un-pushed commit here
# when the commit step loses its race, for the upload-artifact step to collect).
# Runner-only; must never be committed by a stray `git add -A`.
salvage/

# Impeccable design-tooling state (owner decision 2026-08-02: critique
# snapshots ARE tracked — they carry the teardown campaign's trend lines —
# while machine-local state stays out of the tree)
.impeccable/hook.cache.json
.impeccable/config.local.json
.impeccable/design.json
.impeccable/live/
